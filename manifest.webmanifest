{
 "name": "圖片合併工具",
 "short_name": "圖片合併",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#1b1b1d",
 "theme_color": "#1b1b1d",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "images",
     "accept": [
      "image/*"
     ]
    }
   ]
  }
 }
}